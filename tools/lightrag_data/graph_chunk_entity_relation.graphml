  <data key="d0">Fixed Weather Widget Action Item</data>
  <data key="d1">content</data>
  <data key="d2">This action item, recorded on 2026-02-18 with an open status, is a document detailing the modification of a weather widget.</data>
  <data key="d3">chunk-79e8ba17b55951bc715f7656c42eea53</data>
