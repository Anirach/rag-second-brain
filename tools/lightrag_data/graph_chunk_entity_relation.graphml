<node id="arXiv">
  <data key="d0">arXiv</data>
  <data key="d1">organization</data>
  <data key="d2">arXiv is an open-access preprint server for scientific papers, monitored daily for relevant papers in AI, ML, medical AI, and knowledge graphs.&lt;SEP&gt;An open-access preprint server for scientific papers, monitored daily for relevant papers in AI, ML, medical AI, and knowledge graphs.&lt;SEP&gt;An open-access archive for scientific preprints.</data>
  <data key="d3">chunk-c5ba34a6f8c2242b3ad5223bb88b8d02&lt;SEP&gt;chunk-cfa74887b0b129b04310a16bcbf51ffe&lt;SEP&gt;chunk-416882a69b295573c1f83bc323abb20e</data>
