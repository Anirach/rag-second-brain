<node id="Auto-Snapshot">
  <data key="d0">Auto-Snapshot</data>
  <data key="d1">concept</data>
  <data key="d2">A method or process that automatically captures the state of active sessions.&lt;SEP&gt;A feature or process that automatically captures the state of a session.</data>
  <data key="d3">chunk-94a2fbefdc9f95d4468f72555b31c9af&lt;SEP&gt;chunk-3f98dfd0c3dfc54b13cd9aefbd42f73d</data>
